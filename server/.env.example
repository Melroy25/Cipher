# ==========================================
# CIPHER BACKEND ENVIRONMENT CONFIGURATION
# ==========================================

# Database Connection (PostgreSQL - Neon / Supabase / Railway / Self-hosted)
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# Server Secrets (Generate strong random 64-character strings for production)
SESSION_SECRET="generate-a-strong-random-session-secret-change-in-production"
JWT_SECRET="generate-a-strong-random-jwt-secret-change-in-production"

# Server Network Configuration
PORT=4000
NODE_ENV=development
FRONTEND_URL="http://localhost:3000"

# Optional Cloudinary Storage (recommended for persistent cloud media uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Firebase Admin SDK Configuration
# Option A (Local Development): Path to your downloaded service account JSON file
GOOGLE_APPLICATION_CREDENTIALS="./firebase-service-account.json"
FIREBASE_PROJECT_ID="your-project-id"

# Option B (Serverless / Production - e.g. Render / Railway / Vercel):
# Copy values from your service account JSON file directly into environment variables:
# FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgI...\n-----END PRIVATE KEY-----\n"

# Authorized Administrator Emails (comma-separated, case-insensitive)
# Requests to /api/admin/* require a valid Firebase ID token matching an email in this list.
ADMIN_EMAILS="admin@example.com"
